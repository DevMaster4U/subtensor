# Subtensor node service configuration (per-instance template).
# Generated for each node by: ./scripts/build.sh <service_name>
# Installed with:            sudo ./scripts/install_service.sh <service_name> [--start]

# Instance identity (paths are rewritten by build.sh)
SUBTENSOR_SERVICE_NAME=subtensor
SUBTENSOR_INSTALL_PREFIX=/opt/subtensor/nodes/subtensor
SUBTENSOR_BINARY=/opt/subtensor/nodes/subtensor/subtensor
SUBTENSOR_CONFIG_DIR=/opt/subtensor/nodes/subtensor/config
SUBTENSOR_BASE_PATH=/var/lib/subtensor

# Chain (built-in id or path to chainspec JSON)
SUBTENSOR_CHAIN=finney

# Network — set unique port / rpc-port per node instance
SUBTENSOR_PORT=30333
SUBTENSOR_RPC_PORT=9944
SUBTENSOR_RPC_EXTERNAL=true
SUBTENSOR_RPC_CORS=all
SUBTENSOR_RPC_MAX_CONNECTIONS=10000

# Peer limits (passed to --in-peers / --out-peers)
SUBTENSOR_IN_PEERS=512
SUBTENSOR_OUT_PEERS=512

# Comma-separated bootnodes (multiaddr). Leave empty to use chain defaults.
SUBTENSOR_BOOTNODES=/dns/bootnode.finney.chain.opentensor.ai/tcp/30333/ws/p2p/12D3KooWRwbMb85RWnT8DSXSYMWQtuDwh4LJzndoRrTDotTR5gDC

# Comma-separated --reserved-nodes multiaddrs (optional; reserved.txt is also loaded at runtime)
SUBTENSOR_RESERVED_NODES=

# Peer list files (relative to SUBTENSOR_CONFIG_DIR unless absolute)
SUBTENSOR_RESERVED_FILE=
SUBTENSOR_DISABLE_PEERS_FILE=

# Logging (--log filter for Substrate; bot=off hides custom bot::* logs by default)
SUBTENSOR_LOG=info,bot=off
SUBTENSOR_ENABLE_LOG_RELOADING=true

# Sync / pruning
SUBTENSOR_SYNC=warp
SUBTENSOR_NO_MDNS=true

# Extra CLI args (space-separated)
SUBTENSOR_EXTRA_ARGS=

# systemd (scripts/install_service.sh)
SUBTENSOR_SERVICE_USER=subtensor
SUBTENSOR_SERVICE_GROUP=subtensor
